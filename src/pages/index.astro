---
import BaseHead from "../components/BaseHead.astro";

const title = "O Futuro do Rastreamento Veicular: o que muda com a Lei nº 14.967/2024 e a nova regulamentação da segurança privada";
const description = "Live gratuita e online sobre o que a Lei nº 14.967/2024 e a nova regulamentação da segurança privada mudam para centrais de rastreamento e associações. Quarta-feira, 28 de outubro, às 16h30.";

const publico = [
  {
    titulo: "Donos de centrais de rastreamento e associações de proteção veicular",
    texto: "Precisam entender o que a nova lei exige da empresa e o que muda no negócio.",
    icone: '<path d="M4 21V8a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v13M14 21v-9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v9"/><path d="M9 21v-4h2v4M2 21h20"/>',
  },
  {
    titulo: "Gestores de operação e monitoramento",
    texto: "Vão conduzir a adequação no dia a dia sem parar a operação.",
    icone: '<path d="M3 3v18h18"/><path d="M7 15l4-5 3 3 5-7"/>',
  },
  {
    titulo: "Jurídico, compliance e áreas comerciais",
    texto: "Precisam ajustar contratos, documentação e o discurso com o cliente.",
    icone: '<path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4"/>',
  },
];

const aprendizados = [
  "O que é a Lei nº 14.967/2024 e por que ela afeta o mercado de rastreamento",
  "O que muda com a nova regulamentação da segurança privada",
  "Quais pontos da sua central precisam de atenção agora",
  "Os riscos de esperar a regulamentação chegar para se mexer",
  "Como transformar a adequação em vantagem competitiva",
];

// Fotos em /public. Se o arquivo não existir, aparecem as iniciais no lugar.
const convidados = [
  {
    nome: "Alisson Rodrigues da Cruz",
    iniciais: "AC",
    foto: "/alisson-cruz.jpg",
    posicao: "50% 20%",
    cargo: "Fundador e COO | ARC Consultoria",
    bio: "A visão de quem conduz a operação: o que a nova lei muda no dia a dia de centrais e associações e como se adequar sem travar o negócio.",
  },
  {
    nome: "Dalton Castro dos Santos",
    iniciais: "DS",
    foto: "/dalton-santos.jpg",
    posicao: "50% 20%",
    cargo: "Sócio e CCO | ARC Consultoria",
    bio: "O lado comercial da adequação: como a nova regulamentação impacta contratos, vendas e o posicionamento da central diante do cliente.",
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body style="background-color: #070710; color: #ffffff; min-height: 100vh; font-family: Inter, sans-serif;">

    <!-- Fundo gradiente da marca -->
    <div style="position: fixed; inset: 0; z-index: 0; pointer-events: none;">
      <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(var(--brand-rgb),0.18) 0%, transparent 70%); animation: floatBlob 18s ease-in-out infinite;"></div>
      <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 40%; background: radial-gradient(ellipse 60% 40% at 50% 100%, rgba(var(--brand-rgb),0.08) 0%, transparent 70%); animation: floatBlob 22s ease-in-out infinite reverse;"></div>
    </div>

    <div style="position: relative; z-index: 1;">
      <div style="max-width: 560px; margin: 0 auto; padding: 0 clamp(16px, 5vw, 20px);">

        <!-- ===== LOGO ===== -->
        <div class="reveal" style="text-align: center; padding: clamp(26px, 7vw, 36px) 0 clamp(18px, 5vw, 24px); transition-delay: 0ms;">
          <img
            src="/logo-nova-era-laranja.png"
            alt="A Nova Era do Rastreamento Veicular"
            width="640"
            height="632"
            fetchpriority="high"
            style="width: min(170px, 44vw); height: auto; display: inline-block;"
          />
        </div>

        <!-- ===== BADGE EDIÇÃO ===== -->
        <div class="reveal" style="text-align: center; margin-bottom: clamp(16px, 5vw, 24px); transition-delay: 90ms;">
          <span class="badge-pulse" style="display: inline-flex; align-items: center; gap: 6px; background: rgba(var(--brand-rgb),0.12); border: 1px solid rgba(var(--brand-rgb),0.35); border-radius: 9999px; padding: 5px 14px; font-size: 11px; font-weight: 700; color: var(--brand-soft); letter-spacing: 0.06em; text-transform: uppercase;">
            Live Exclusiva — 9ª Edição
          </span>
        </div>

        <!-- ===== TÍTULO ===== -->
        <div class="reveal" style="text-align: center; margin-bottom: clamp(14px, 4vw, 20px); transition-delay: 180ms;">
          <h1 style="font-size: clamp(22px, 6vw, 36px); font-weight: 900; line-height: 1.25; color: #ffffff; margin: 0; word-break: break-word; text-wrap: balance;">
            O Futuro do Rastreamento
            <span style="color: var(--brand-soft); display: inline;">Veicular</span>
          </h1>
          <p style="font-size: clamp(14px, 3.6vw, 17px); font-weight: 800; line-height: 1.4; color: #e5e7eb; margin: 10px 0 0 0; text-wrap: balance;">
            O que muda com a Lei nº 14.967/2024 e a nova regulamentação da segurança privada
          </p>
        </div>

        <!-- ===== SUBTÍTULO ===== -->
        <div class="reveal" style="text-align: center; margin-bottom: clamp(20px, 6vw, 28px); transition-delay: 270ms;">
          <p style="font-size: clamp(14px, 3.8vw, 16px); color: #9ca3af; line-height: 1.65; margin: 0; text-wrap: pretty;">
            A regulamentação da segurança privada chegou ao rastreamento.
            <strong style="color: #e5e7eb;">Entenda o que muda para a sua central antes que vire problema.</strong>
          </p>
        </div>

        <!-- ===== DATA E HORÁRIO ===== -->
        <div class="reveal" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-bottom: clamp(14px, 4vw, 20px); transition-delay: 360ms;">
          <div style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 10px clamp(12px, 4vw, 16px);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
            <span style="font-size: 13px; color: #d1d5db;">Quarta, <strong style="color: #ffffff;">28/10</strong></span>
          </div>
          <div style="display: flex; align-items: center; gap: 8px; background: rgba(var(--brand-rgb),0.1); border: 1px solid rgba(var(--brand-rgb),0.3); border-radius: 10px; padding: 10px clamp(12px, 4vw, 16px);">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
            <span style="font-size: 13px; color: #d1d5db;">Horário: <strong style="color: var(--brand-soft);">16H30</strong></span>
          </div>
        </div>

        <!-- ===== TRANSMISSÃO ===== -->
        <div class="reveal" style="display: flex; justify-content: center; margin-bottom: clamp(28px, 8vw, 40px); transition-delay: 400ms;">
          <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 9999px; padding: 8px 16px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#ff0033" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.12-2.13C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.52A3 3 0 0 0 .5 6.2 31.4 31.4 0 0 0 0 12a31.4 31.4 0 0 0 .5 5.8 3 3 0 0 0 2.12 2.13c1.88.52 9.38.52 9.38.52s7.5 0 9.38-.52a3 3 0 0 0 2.12-2.13A31.4 31.4 0 0 0 24 12a31.4 31.4 0 0 0-.5-5.8z"/><path d="M9.6 15.6 15.8 12 9.6 8.4z" fill="#ffffff"/></svg>
            <span style="font-size: 12px; font-weight: 700; color: #d1d5db; letter-spacing: 0.03em;">Ao vivo e gratuito no YouTube</span>
          </div>
        </div>

        <!-- ===== FORMULÁRIO ===== -->
        <div class="reveal" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: clamp(22px, 6vw, 32px) clamp(18px, 5vw, 24px); margin-bottom: clamp(36px, 9vw, 56px); transition-delay: 450ms;">
          <p style="text-align: center; font-size: 14px; font-weight: 700; color: #e5e7eb; margin: 0 0 20px 0;">
            Garanta sua vaga gratuita agora:
          </p>

          <div id="form-fields" style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
            <input
              id="field-name"
              type="text"
              placeholder="Seu nome completo"
              autocomplete="name"
              style="width: 100%; padding: 13px 16px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #ffffff; font-size: 14px; outline: none; box-sizing: border-box;"
            />
            <input
              id="field-email"
              type="email"
              placeholder="Seu melhor e-mail"
              autocomplete="email"
              style="width: 100%; padding: 13px 16px; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; color: #ffffff; font-size: 14px; outline: none; box-sizing: border-box;"
            />
            <div style="display: flex; align-items: center; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden; box-sizing: border-box;" id="phone-wrapper">
              <span style="padding: 13px 12px 13px 16px; color: rgba(255,255,255,0.5); font-size: 14px; white-space: nowrap; border-right: 1px solid rgba(255,255,255,0.1); user-select: none;">+55</span>
              <input
                id="field-phone"
                type="tel"
                placeholder="(11) 9 0000-0000"
                maxlength="16"
                autocomplete="tel"
                style="flex: 1; padding: 13px 16px; background: transparent; border: none; color: #ffffff; font-size: 14px; outline: none; box-sizing: border-box; min-width: 0;"
              />
            </div>
          </div>

          <div id="form-error" role="alert" style="display:none; color:#f87171; font-size:13px; text-align:center; margin-bottom:10px;"></div>

          <div id="form-success" style="display:none; text-align:center; padding: 16px 0;">
            <div style="width: 36px; height: 36px; margin: 0 auto 10px; background: rgba(var(--brand-rgb),0.15); border: 1px solid rgba(var(--brand-rgb),0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-9"/></svg>
            </div>
            <p style="font-size:15px; font-weight:800; color:#ffffff; margin:0 0 4px 0;">Inscrição confirmada!</p>
            <p style="font-size:13px; color:#9ca3af; margin:0;">Fique de olho no seu WhatsApp e e-mail.</p>
          </div>

          <button
            id="btn-submit"
            type="button"
            class="btn-brand"
            style="width: 100%; padding: 15px; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); border: none; border-radius: 10px; color: #ffffff; font-size: clamp(13px, 3.6vw, 15px); font-weight: 900; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; white-space: nowrap; box-shadow: 0 4px 20px rgba(var(--brand-glow),0.3);">
            GARANTIR MINHA VAGA →
          </button>

          <p style="text-align: center; font-size: 11px; color: #4b5563; margin: 14px 0 0 0; display: flex; align-items: center; justify-content: center; gap: 5px;">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            Evento 100% gratuito e online. Sua vaga é pessoal e intransferível.
          </p>
        </div>

        <!-- ===== PARA QUEM É ===== -->
        <div class="reveal" style="margin-bottom: clamp(36px, 9vw, 56px);">
          <p style="text-align: center; font-size: 11px; font-weight: 900; color: var(--brand-soft); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 16px 0;">
            Para quem é essa live
          </p>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            {publico.map((item) => (
              <div class="hover-card" style="display: flex; align-items: flex-start; gap: 14px; background: rgba(var(--brand-rgb),0.06); border: 1px solid rgba(var(--brand-rgb),0.25); border-radius: 14px; padding: clamp(14px, 4vw, 18px);">
                <div style="flex-shrink: 0; width: 32px; height: 32px; background: rgba(var(--brand-rgb),0.15); border-radius: 9px; display: flex; align-items: center; justify-content: center;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icone} /></div>
                <div>
                  <p style="font-size: clamp(13px, 3.6vw, 14px); font-weight: 800; color: #ffffff; margin: 0 0 4px 0; text-wrap: pretty;">{item.titulo}</p>
                  <p style="font-size: clamp(12px, 3.3vw, 13px); color: #9ca3af; margin: 0; line-height: 1.5; text-wrap: pretty;">{item.texto}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ===== NESTA LIVE VOCÊ VAI APRENDER ===== -->
        <div class="reveal" style="margin-bottom: clamp(36px, 9vw, 56px);">
          <p style="text-align: center; font-size: 11px; font-weight: 900; color: var(--brand-soft); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 16px 0;">
            Nesta live você vai aprender
          </p>

          <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 14px; overflow: hidden;">
            {aprendizados.map((item, i) => (
              <div class="reveal-item" style={`display: flex; align-items: flex-start; gap: 12px; padding: 14px 16px; transition-delay: ${i * 70}ms;${i > 0 ? " border-top: 1px solid rgba(255,255,255,0.05);" : ""}`}>
                <div style="flex-shrink: 0; width: 20px; height: 20px; background: rgba(var(--brand-rgb),0.2); border: 1px solid rgba(var(--brand-rgb),0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-top: 1px;">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12l5 5 9-9"/>
                  </svg>
                </div>
                <p style="font-size: clamp(12.5px, 3.5vw, 13.5px); color: #d1d5db; line-height: 1.5; margin: 0; text-wrap: pretty;">{item}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- ===== CONVIDADOS DA EDIÇÃO ===== -->
        <div class="reveal" style="margin-bottom: 20px;">
          <p style="text-align: center; font-size: 11px; font-weight: 900; color: var(--brand-soft); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 12px 0;">
            Convidados desta edição
          </p>
          <div class="guest-grid">
            {convidados.map((c) => (
              <div class="hover-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden;">
                <div class="photo-slot" style="position: relative; overflow: hidden; height: clamp(210px, 52vw, 300px); background: linear-gradient(160deg, rgba(var(--brand-rgb),0.14), rgba(0,0,0,0));">
                  <span class="photo-fallback" aria-hidden="true">{c.iniciais}</span>
                  <img
                    class="photo-zoom"
                    src={c.foto}
                    alt={c.nome}
                    loading="lazy"
                    onerror="this.closest('.photo-slot').classList.add('photo-missing'); this.remove();"
                    style={`width: 100%; height: 100%; display: block; object-fit: cover; object-position: ${c.posicao};`}
                  />
                  <div style="position: absolute; inset: 0px; background: linear-gradient(transparent 60%, rgb(7,7,16) 100%); pointer-events: none;"></div>
                </div>
                <div style="padding: 18px 18px 20px;">
                  <h3 style="font-size: 17px; font-weight: 900; color: #ffffff; margin: 0 0 4px 0;">{c.nome}</h3>
                  <p style="font-size: 11px; font-weight: 700; color: var(--brand-soft); text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 10px 0; text-wrap: pretty;">{c.cargo}</p>
                  <p style="font-size: clamp(12.5px, 3.4vw, 13px); color: #9ca3af; line-height: 1.55; margin: 0; text-wrap: pretty;">{c.bio}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- ===== APRESENTADO POR: VINICIUS COSTA ===== -->
        <div class="reveal" style="margin-bottom: clamp(36px, 9vw, 56px);">
          <p style="text-align: center; font-size: 11px; font-weight: 900; color: var(--brand-soft); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 12px 0;">
            Apresentado por
          </p>
          <div class="hover-card" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 14px; overflow: hidden;">
            <div style="position: relative; overflow: hidden; height: clamp(240px, 62vw, 320px);">
              <img
                class="photo-zoom"
                src="/vinicius-foto.jpg"
                alt="Vinicius Costa"
                loading="lazy"
                style="width: 100%; height: 100%; display: block; object-fit: cover; object-position: 68% 38%;"
              />
              <div style="position: absolute; inset: 0px; background: linear-gradient(transparent 60%, rgb(7,7,16) 100%);"></div>
            </div>
            <div style="padding: 20px 20px 22px;">
              <h3 style="font-size: 18px; font-weight: 900; color: #ffffff; margin: 0 0 4px 0;">Vinicius Costa</h3>
              <p style="font-size: 11px; font-weight: 700; color: var(--brand-soft); text-transform: uppercase; letter-spacing: 0.06em; margin: 0 0 12px 0;">Sócio Fundador da Nova Era do Rastreamento</p>
              <p style="font-size: clamp(12.5px, 3.4vw, 13px); color: #9ca3af; line-height: 1.55; margin: 0; text-wrap: pretty;">
                <strong style="color: #e5e7eb;">20 anos no mercado de rastreamento</strong> e uma das operações mais sólidas do setor no Brasil. Criador do movimento Nova Era.
              </p>
            </div>
          </div>
        </div>

        <!-- ===== A NOVA ERA (MANIFESTO) ===== -->
        <div class="reveal" style="margin-bottom: clamp(36px, 9vw, 56px);">
          <p style="text-align: center; font-size: 11px; font-weight: 900; color: var(--brand-soft); letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 16px 0;">
            A Nova Era
          </p>
          <div style="background: linear-gradient(160deg, rgba(var(--brand-rgb),0.1), rgba(0,0,0,0)); border: 1px solid rgba(var(--brand-rgb),0.25); border-radius: 16px; padding: 32px 24px; text-align: center;">
            <p style="font-size: clamp(16px, 4.4vw, 19px); font-weight: 900; line-height: 1.35; color: #ffffff; margin: 0 0 16px 0; text-wrap: balance;">
              EXISTEM DOIS TIPOS DE CENTRAL DE RASTREAMENTO:
              <span style="color: var(--brand-soft);">AS QUE ESTÃO CRIANDO A NOVA ERA</span>,
              E AS QUE VÃO PRECISAR SE ADAPTAR A ELA.
            </p>
            <p style="font-size: clamp(13px, 3.5vw, 14px); color: #9ca3af; line-height: 1.65; margin: 0; text-wrap: pretty;">
              A diferença entre os dois grupos não é sorte. É quem decidiu prestar atenção primeiro.
            </p>
          </div>
        </div>

        <!-- ===== CTA SIMPLES ===== -->
        <div class="reveal" style="margin-bottom: 40px; text-align: center;">
          <button
            id="btn-scroll-form"
            type="button"
            class="btn-brand"
            style="width: 100%; padding: 16px; background: linear-gradient(135deg, var(--brand), var(--brand-deep)); border: none; border-radius: 10px; color: #ffffff; font-size: clamp(13px, 3.6vw, 15px); font-weight: 900; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; white-space: nowrap; box-shadow: 0 4px 20px rgba(var(--brand-glow),0.3);">
            QUERO MINHA VAGA →
          </button>
        </div>

        <!-- ===== FOOTER ===== -->
        <div style="text-align: center; padding: 16px 0 40px; border-top: 1px solid rgba(255,255,255,0.05);">
          <p style="font-size: 11px; color: #374151; margin: 0;">
            © 2026 Nova Era das Centrais de Rastreamento. Todos os direitos reservados.
          </p>
        </div>

      </div>
    </div>

    <!-- Paleta global: precisa ficar fora do escopo do Astro para valer nos style inline -->
    <style is:inline>
      :root {
        /* Cor de referência da marca: laranja */
        --brand: #ff7f00;
        --brand-deep: #b85a00;
        --brand-soft: #ff9f40;
        --brand-rgb: 255, 159, 64;
        --brand-glow: 255, 127, 0;
      }
    </style>

    <style is:inline>
      input::placeholder { color: #6b7280; }
      input:focus { border-color: rgba(var(--brand-rgb),0.5) !important; outline: none !important; }
      #phone-wrapper:focus-within { border-color: rgba(var(--brand-rgb),0.5) !important; }
      .btn-brand:hover { opacity: 0.92; transform: translateY(-1px); }
      .btn-brand:focus-visible { outline: 2px solid var(--brand-soft); outline-offset: 3px; }
      .btn-brand {
        transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        animation: ctaGlow 2.8s ease-in-out infinite;
      }

      .guest-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-bottom: 36px;
      }
      @media (min-width: 480px) {
        .guest-grid { grid-template-columns: 1fr 1fr; }
      }

      /* Placeholder mostrado enquanto a foto da convidada não estiver em /public */
      .photo-fallback {
        position: absolute;
        inset: 0;
        display: none;
        align-items: center;
        justify-content: center;
        font-size: 44px;
        font-weight: 900;
        letter-spacing: 0.04em;
        color: rgba(var(--brand-rgb),0.55);
      }
      .photo-slot.photo-missing .photo-fallback { display: flex; }

      @keyframes floatBlob {
        0%, 100% { transform: translate(0, 0) scale(1); }
        50% { transform: translate(-16px, 18px) scale(1.08); }
      }

      @keyframes ctaGlow {
        0%, 100% { box-shadow: 0 4px 20px rgba(var(--brand-glow),0.3); }
        50% { box-shadow: 0 4px 28px rgba(var(--brand-glow),0.5); }
      }

      @keyframes badgeGlow {
        0%, 100% { box-shadow: 0 0 0 rgba(var(--brand-glow),0); }
        50% { box-shadow: 0 0 14px rgba(var(--brand-glow),0.4); }
      }
      .badge-pulse { animation: badgeGlow 2.6s ease-in-out infinite; }

      .reveal, .reveal-item {
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.7s cubic-bezier(0.16,1,0.3,1), transform 0.7s cubic-bezier(0.16,1,0.3,1);
      }
      .reveal.in-view, .reveal-item.in-view {
        opacity: 1;
        transform: translateY(0);
      }

      .hover-card {
        transition: transform 0.3s ease, border-color 0.3s ease;
      }
      .hover-card:hover {
        transform: translateY(-4px);
        border-color: rgba(var(--brand-rgb),0.5) !important;
      }
      .photo-zoom {
        position: relative;
        transition: transform 0.5s ease;
      }
      .hover-card:hover .photo-zoom {
        transform: scale(1.05);
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal, .reveal-item { opacity: 1 !important; transform: none !important; transition: none !important; }
        .badge-pulse, .btn-brand, [style*="floatBlob"] { animation: none !important; }
      }
    </style>

    <script is:inline>
      const revealEls = document.querySelectorAll('.reveal, .reveal-item');
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach((el) => revealObserver.observe(el));
    </script>

    <!-- Formulário de inscrição: lógica em src/scripts/inscricao.js (depende só dos IDs dos campos) -->
    <script>
      import "../scripts/inscricao.js";
    </script>

  </body>
</html>
