---
import BaseHead from "../components/BaseHead.astro";

const title = "Inscrição Confirmada! — Nova Era das Centrais de Rastreamento";
const description = "Sua inscrição foi confirmada! Entre no grupo da comunidade para receber o link de acesso.";
const WHATSAPP_GROUP = "https://chat.whatsapp.com/I6Vl2GxaEOk0g5JG5oEfeH";

const whatsappIcon = '<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.554 4.118 1.528 5.855L.057 23.885l6.191-1.45A11.946 11.946 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.803 9.803 0 01-5.031-1.384l-.36-.214-3.733.874.942-3.642-.235-.374A9.803 9.803 0 012.182 12c0-5.418 4.4-9.818 9.818-9.818 5.418 0 9.818 4.4 9.818 9.818 0 5.418-4.4 9.818-9.818 9.818z"/>';
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <BaseHead title={title} description={description} />
    <style is:inline>
      :root {
        /* Cor de referência da marca: laranja (igual ao index.astro) */
        --brand: #ff7f00;
        --brand-deep: #b85a00;
        --brand-soft: #ff9f40;
        --brand-rgb: 255, 159, 64;
        --brand-glow: 255, 127, 0;
      }
    </style>
  </head>

  <body style="background-color: #070710; color: #ffffff; min-height: 100vh; font-family: Inter, sans-serif; display: flex; flex-direction: column; align-items: center; justify-content: center;">

    <!-- Fundo gradiente rosa -->
    <div style="position: fixed; inset: 0; z-index: 0; pointer-events: none;">
      <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 80% 50% at 50% -10%, rgba(var(--brand-rgb),0.22) 0%, transparent 70%);"></div>
      <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 40%; background: radial-gradient(ellipse 60% 40% at 50% 100%, rgba(var(--brand-rgb),0.10) 0%, transparent 70%);"></div>
    </div>

    <div style="position: relative; z-index: 1; width: 100%; max-width: 520px; margin: 0 auto; padding: clamp(28px, 8vw, 40px) clamp(16px, 5vw, 20px); box-sizing: border-box;">

      <!-- LOGO -->
      <div style="text-align: center; margin-bottom: 32px;">
        <img
          src="/logo-nova-era-rosa.png"
          alt="A Nova Era do Rastreamento Veicular"
          style="width: 220px; height: auto; display: inline-block;"
        />
      </div>

      <!-- ÍCONE DE SUCESSO -->
      <div style="text-align: center; margin-bottom: 24px;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 72px; height: 72px; background: rgba(var(--brand-rgb),0.15); border: 2px solid rgba(var(--brand-rgb),0.4); border-radius: 50%;">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12l5 5 9-9"/>
          </svg>
        </div>
      </div>

      <!-- TÍTULO -->
      <div style="text-align: center; margin-bottom: 12px;">
        <h1 style="font-size: clamp(26px, 6vw, 36px); font-weight: 900; line-height: 1.2; color: #ffffff; margin: 0;">
          Inscrição <span style="color: var(--brand-soft);">Confirmada!</span>
        </h1>
      </div>

      <!-- SUBTÍTULO -->
      <p style="text-align: center; font-size: 15px; color: rgba(255,255,255,0.55); line-height: 1.6; margin: 0 0 36px 0;">
        Você está inscrito na live <strong style="color: rgba(255,255,255,0.85);">O Futuro do Rastreamento Veicular</strong><br/>
        Quarta-feira, 28/10, às 16H30. Entre no grupo para receber o link de acesso.
      </p>

      <!-- CARD CTA WHATSAPP -->
      <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 28px 24px; margin-bottom: 24px; text-align: center;">

        <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 10px;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#25D366" set:html={whatsappIcon} />
          <span style="font-size: 12px; font-weight: 700; color: #25D366; text-transform: uppercase; letter-spacing: 0.08em;">Grupo Oficial</span>
        </div>

        <p style="font-size: 13px; color: rgba(255,255,255,0.45); line-height: 1.6; margin: 0 0 20px 0;">
          Entre no grupo da comunidade agora. É lá que enviaremos o link de acesso, lembretes e conteúdos exclusivos antes da live.
        </p>

        <a
          href={WHATSAPP_GROUP}
          target="_blank"
          rel="noopener noreferrer"
          style="display: flex; align-items: center; justify-content: center; gap: 10px; width: 100%; padding: 16px; background: linear-gradient(135deg, #16a34a, #15803d); border: none; border-radius: 12px; color: #ffffff; font-size: clamp(13px, 3.6vw, 15px); font-weight: 900; letter-spacing: 0.03em; text-decoration: none; box-shadow: 0 4px 20px rgba(22,163,74,0.25); transition: all 0.2s ease; box-sizing: border-box;"
          onmouseover="this.style.opacity='0.9'; this.style.transform='translateY(-1px)'"
          onmouseout="this.style.opacity='1'; this.style.transform='translateY(0)'"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff" set:html={whatsappIcon} />
          Entrar no Grupo da Comunidade
        </a>
      </div>

      <!-- INFO DATA -->
      <div style="display: flex; justify-content: center; gap: 16px; margin-bottom: 36px;">
        <div style="display: flex; align-items: center; gap: 7px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; padding: 8px 14px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span style="font-size: 12px; color: #d1d5db;">Quarta, <strong style="color: #ffffff;">28/10</strong></span>
        </div>
        <div style="display: flex; align-items: center; gap: 7px; background: rgba(var(--brand-rgb),0.1); border: 1px solid rgba(var(--brand-rgb),0.3); border-radius: 10px; padding: 8px 14px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" style="color: var(--brand-soft);" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          <span style="font-size: 12px; color: #d1d5db;">Horário: <strong style="color: var(--brand-soft);">16H30</strong></span>
        </div>
      </div>

      <!-- FOOTER -->
      <div style="text-align: center; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 20px;">
        <p style="font-size: 11px; color: #374151; margin: 0;">
          © 2026 Nova Era das Centrais de Rastreamento. Todos os direitos reservados.
        </p>
      </div>

    </div>

  </body>
</html>
